# --- Project-specific ---------------------------------------------------
# GHDL analysis artifacts -- `ghdl -a` writes these into the current
# working directory (wherever elaborate() is invoked from), not into the
# fixture directory being analyzed.
*.o
work-obj*.cf

# Regeneration output from tests/frontend/golden_simple10/regenerate.py --
# derived from the fixtures beside it, rebuilt on demand, and asserted
# against by nothing.
tests/frontend/golden_simple10/generated/

# Saved projects. These are a USER's own work, created by
# "File > Save Project" -- the examples/ designs are what ships, not
# whatever was saved while testing locally.
*.pis
# ...except each bundled example's own finished project, which the
# README's quickstart opens (`examples/aura_top/aura_top.pis`).
!examples/**/*.pis

# Local agent/tool settings, which can contain machine-specific
# absolute paths.
.claude/

# Third-party specification PDFs kept locally for reference. NOT
# committed: the Si2 CPF specification carries an explicit "no right or
# license is granted or implied under any copyrights in or to the CPF
# Document" notice. Remove this line deliberately if redistribution is
# ever cleared.
docs/reference/*.pdf
