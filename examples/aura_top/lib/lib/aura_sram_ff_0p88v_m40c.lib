        rise_constraint (scalar) { values ("3.8400"); }
        fall_constraint (scalar) { values ("3.8400"); }
      }
    }

    /* Leakage is state dependent: the retention state is what the
       UPF PD_MEM retention strategy trades read/write access for. */
    leakage_power () {
      when : "PDN & RETN";
      value : 883.66;
    }
    leakage_power () {
      when : "PDN & !RETN";
      value : 97.2;
    }
    leakage_power () {
      when : "!PDN";
      value : 1.77;
    }
  }

