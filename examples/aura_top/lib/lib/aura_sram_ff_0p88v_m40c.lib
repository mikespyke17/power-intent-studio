               "0.0695, 0.0933, 0.1884, 0.4580",\
               "0.1107, 0.1356, 0.2354, 0.5180",\
               "0.1931, 0.2203, 0.3293, 0.6380");
        }
      }
    }

    pin (RETN) {
      direction : input;
      capacitance : 0.0058;
      max_transition : 0.4000;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      timing () {
        related_pin : "RETN";
        timing_type : min_pulse_width;
        rise_constraint (scalar) { values ("1.9200"); }
        fall_constraint (scalar) { values ("1.9200"); }
      }
    }

    pin (PDN) {
      direction : input;
      capacitance : 0.0058;
      max_transition : 0.4000;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      timing () {
        related_pin : "PDN";
        timing_type : min_pulse_width;
        rise_constraint (scalar) { values ("3.8400"); }
        fall_constraint (scalar) { values ("3.8400"); }
      }
    }

    /* Leakage is state dependent: the retention state is what the
       UPF PD_MEM retention strategy trades read/write access for. */
    leakage_power () {
      when : "PDN & RETN";
      value : 737.45;
    }
    leakage_power () {
      when : "PDN & !RETN";
      value : 81.12;
    }
    leakage_power () {
      when : "!PDN";
      value : 1.47;
    }
  }

}
