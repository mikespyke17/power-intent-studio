                     "0.1081, 0.1147, 0.1411, 0.1939",\
                     "0.1753, 0.1819, 0.2083, 0.2611");
        }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (mem_constraint) {
          values ("0.0419, 0.0485, 0.0749, 0.1277",\
                     "0.0503, 0.0569, 0.0833, 0.1361",\
                     "0.0839, 0.0905, 0.1169, 0.1697",\
