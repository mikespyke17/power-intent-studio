      timing () {
        related_pin : "RETN";
        timing_type : min_pulse_width;
        rise_constraint (scalar) { values ("1.9200"); }
        fall_constraint (scalar) { values ("1.9200"); }
      }
    }

    pin (PDN) {
      direction : input;
      capacitance : 0.0058;
      max_transition : 0.4000;
