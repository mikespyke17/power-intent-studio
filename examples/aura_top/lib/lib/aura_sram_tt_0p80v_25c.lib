    bus (Q) {
      bus_type : bus_32;
      direction : output;
      max_capacitance : 0.1000;
      max_transition : 0.4000;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      power_down_function : "!VDD + VSS";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise (mem_delay) {
          values ("0.8716, 0.8950, 0.9890, 1.2553",\
               "0.8818, 0.9056, 1.0008, 1.2703",\
