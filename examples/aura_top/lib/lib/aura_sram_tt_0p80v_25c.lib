/* -------------------------------------------------------------------------
 * aura_sram_tt_0p80v_25c.lib
 *
 * Liberty models for the AURA SoC memory macros.
 * Corner: TT, 0.8 V, 25.0 C
 *
 * Cell names match the RTL module names instantiated in
 * rtl/macro/sram_wrap.sv, so a Liberty-to-RTL binding pass resolves them
 * directly.  Power-aware attributes that matter for the UPF:
 *
 *   pg_pin              VDD / VSS, connected explicitly by connect_supply_net
 *   power_down_function on every output bus, so outputs are corrupt when the
 *                       rail collapses and isolation is required
 *   retention_pin       on RETN, matching the PD_MEM retention strategy
 *   leakage_power/when  three states: active, retained, powered down
 *
 * Timing and power values are representative, not silicon-characterised.
 * ------------------------------------------------------------------------- */

library (aura_sram_tt_0p80v_25c) {

  technology (cmos);
  delay_model : table_lookup;
  library_features (report_delay_calculation);

  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, pf);

  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 0.8;

  voltage_map (VDD, 0.8);
  voltage_map (VSS, 0.00);

  operating_conditions (tt_0p80v_25c) {
    process : 1.0;
    temperature : 25.0;
    voltage : 0.8;
    tree_type : balanced_tree;
  }
  default_operating_conditions : tt_0p80v_25c;

  input_threshold_pct_rise : 50.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_lower_threshold_pct_rise : 30.0;
  slew_lower_threshold_pct_fall : 30.0;
  slew_upper_threshold_pct_rise : 70.0;
  slew_upper_threshold_pct_fall : 70.0;
  slew_derate_from_library : 1.0;

  default_leakage_power_density : 0.0;
  default_cell_leakage_power : 0.0;
  default_max_transition : 0.4000;
  default_fanout_load : 1.0;
  default_inout_pin_cap : 0.0;
  default_input_pin_cap : 0.0;
  default_output_pin_cap : 0.0;

  lu_table_template (mem_delay) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.0100, 0.0400, 0.1600, 0.4000");
    index_2 ("0.0020, 0.0080, 0.0320, 0.1000");
  }

  lu_table_template (mem_constraint) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.0100, 0.0400, 0.1600, 0.4000");
    index_2 ("0.0100, 0.0400, 0.1600, 0.4000");
  }

  power_lut_template (mem_energy) {
    variable_1 : input_transition_time;
    index_1 ("0.0100, 0.0400, 0.1600, 0.4000");
  }

  power_lut_template (mem_energy_2d) {
    variable_1 : input_transition_time;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.0100, 0.0400, 0.1600, 0.4000");
    index_2 ("0.0020, 0.0080, 0.0320, 0.1000");
  }

  type (bus_4) {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
    downto : true;
  }

  type (bus_7) {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
    downto : true;
  }

  type (bus_9) {
    base_type : array;
    data_type : bit;
    bit_width : 9;
    bit_from : 8;
    bit_to : 0;
    downto : true;
  }

  type (bus_10) {
    base_type : array;
    data_type : bit;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0;
    downto : true;
  }

  type (bus_32) {
    base_type : array;
    data_type : bit;
    bit_width : 32;
    bit_from : 31;
    bit_to : 0;
    downto : true;
  }

  cell (sram_1rw_1024x32) {
    /* mem_subsys SRAM banks (4 instances) */
    area : 6699.7;
    dont_touch : true;
    dont_use : true;
    is_macro_cell : true;
    interface_timing : true;
    pad_cell : false;
    cell_leakage_power : 1606.66;

    memory () {
      type : ram;
      address_width : 10;
      word_width : 32;
    }

    pg_pin (VDD) {
      voltage_name : VDD;
      pg_type : primary_power;
    }

    pg_pin (VSS) {
      voltage_name : VSS;
      pg_type : primary_ground;
    }

    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.0180;
      max_transition : 0.4000;
      min_pulse_width_high : 0.2400;
      min_pulse_width_low : 0.2400;
      min_period : 0.9600;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      internal_power () {
        rise_power (mem_energy) {
          values ("0.04416, 0.05211, 0.06006, 0.06801");
        }
        fall_power (mem_energy) {
          values ("0.03798, 0.04481, 0.05165, 0.05849");
        }
      }
    }

    pin (CEN) {
      direction : input;
      capacitance : 0.0065;
      max_transition : 0.4000;
      related_power_pin : VDD;
      related_ground_pin : VSS;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (mem_constraint) {
          values ("0.0910, 0.0976, 0.1240, 0.1768",\
                     "0.0994, 0.1060, 0.1324, 0.1852",\
                     "0.1330, 0.1396, 0.1660, 0.2188",\
                     "0.2002, 0.2068, 0.2332, 0.2860");
        }
        fall_constraint (mem_constraint) {
          values ("0.0910, 0.0976, 0.1240, 0.1768",\
                     "0.0994, 0.1060, 0.1324, 0.1852",\
                     "0.1330, 0.1396, 0.1660, 0.2188",\
                     "0.2002, 0.2068, 0.2332, 0.2860");
        }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (mem_constraint) {
          values ("0.0570, 0.0636, 0.0900, 0.1428",\
                     "0.0654, 0.0720, 0.0984, 0.1512",\
                     "0.0990, 0.1056, 0.1320, 0.1848",\
                     "0.1662, 0.1728, 0.1992, 0.2520");
        }
        fall_constraint (mem_constraint) {
